    },
    "./tools/websearch": {
      "types": "./dist/tools/websearch.d.ts",
      "import": "./dist/tools/websearch.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest tests",
    "coverage": "vitest run tests --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@zcode/shared": "workspace:*",
    "zod": "^3.24.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.5"
