{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zcode: tsup watch (debug)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/tsup-watch.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-debug"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "\\[HOST\\] CLI Watching for changes in"
        }
      }
    },
    {
      "label": "zcode: vite dev",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/vite-dev.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-debug"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "VITE v.*ready in .*"
        }
      }
    },
    {
      "label": "zcode: prepare desktop debug",
      "dependsOn": [
        "zcode: tsup watch (debug)",
        "zcode: vite dev"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "zcode: start electron (debug)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/start-electron.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "dependsOn": [
        "zcode: prepare desktop debug"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-debug"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Debugger listening on ws://127\\.0\\.0\\.1:9231/"
        }
      }
    },
    {
      "label": "zcode: start electron (debug with host inspect)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/start-electron.mjs",
        "--host-inspect"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "dependsOn": [
        "zcode: prepare desktop debug"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-debug"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Debugger listening on ws://127\\.0\\.0\\.1:9231/"
        }
      }
    }
  ]
}
