{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Bugfix: runtime feature helper 有意以 JS 形式存放，使 Node prepare 脚本与 TypeScript 包
    // 在 shared 构建前即可导入同一份运行时契约。
    // 允许 shared 编译复制该 JS，避免 dist/index.js 导出一个不存在的文件。
    "allowJs": true
  },
  "include": ["src"]
}
