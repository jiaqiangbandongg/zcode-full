{
  "version": 1,
  "caseName": "conversation-session-plugin-mcp-skill-workspace-enabled",
  "spec": "./test/e2e/conversation-session/conversation-session-plugin-mcp-skill-workspace-enabled.test.ts",
  "fixtures": [
    {
      "id": "workspace-enabled-tool-call",
      "description": "Workspace Plugin enabled：模型收到并调用 namespaced MCP tool。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "tool-use",
        "source": "synthetic",
        "syntheticReason": "固定 tool_use，避免 provider 行为随机性影响 Plugin runtime 断言。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_PLUGIN_MCP_PING_INSTALLED_ENABLED"],
        "bodyIncludes": ["E2E_PLUGIN_MCP_PING_INSTALLED_ENABLED"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "replay": { "consumeOnce": true },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_plugin_mcp_ping_workspace_enabled",
          "name": "mcp__plugin_e2e-plugin-mcp-ping_ping__ping",
          "input": { "message": "ping-workspace-enabled" }
        }
      }
    },
    {
      "id": "workspace-enabled-final",
      "description": "Workspace Plugin MCP tool_result 后的最终响应。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "固定最终文本，闭合 Workspace Plugin MCP runtime。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["E2E_PLUGIN_MCP_PING_INSTALLED_ENABLED", "toolu_e2e_plugin_mcp_ping_workspace_enabled"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": { "statusCode": 200, "text": "upstream-e2e-ok" }
    }
  ]
}
