      "description": "N05：主 turn 在 queue 入队窗口后返回 500 JSON error。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fault-stream",
        "source": "synthetic",
        "syntheticReason": "真实 provider 500 的响应时间不可控；delayMs 只用于稳定制造 running admission 窗口，验证错误终态的 queue 保留契约。"
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_TURN_ERROR_QUEUE_SOURCE"],
        "bodyIncludes": ["E2E_TURN_ERROR_QUEUE_SOURCE"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "delayMs": 3000,
        "statusCode": 500,
        "statusMessage": "Internal Server Error",
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": "{\"error\":{\"message\":\"synthetic provider failure\",\"type\":\"provider_error\",\"code\":\"e2e_turn_error\"}}"
      }
    },
    {
      "id": "turn-error-queue-preserved-followup",
      "description": "NQ：错误后的队首输入显式继续消费成功。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "恢复路径需要固定 assistant 哨兵，证明 queue 未丢失且只在显式继续后发送。"
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_TURN_ERROR_QUEUE_FOLLOWUP"],
        "bodyIncludes": ["E2E_TURN_ERROR_QUEUE_FOLLOWUP"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "turn-error-queue-preserved-followup",
          "inputTokens": 96,
          "outputTokens": 8,
          "text": "TURN_ERROR_QUEUE_RECOVERED"
        }
      }
    }
  ]
}
