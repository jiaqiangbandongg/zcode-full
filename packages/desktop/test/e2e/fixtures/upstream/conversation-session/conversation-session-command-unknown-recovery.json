{
  "version": 1,
  "caseName": "conversation-session-command-unknown-recovery",
  "spec": "./test/e2e/conversation-session/conversation-session-command-unknown-recovery.test.ts",
  "fixtures": [
    {
      "id": "command-unknown-recovery-title",
      "description": "PV4-25U 前置 session 的 case-local 标题响应。",
      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "稳定创建一个可在 renderer reload 后恢复的普通 session；标题不是断言目标。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "Generate a concise title",
          "E2E_COMMAND_UNKNOWN_RECOVERY"
        ]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "command-unknown-recovery-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"Command Unknown Recovery E2E\"}"
        }
      }
    },
    {
      "id": "command-unknown-recovery-turn",
      "description": "PV4-25U 建立已完成 session，随后用真实 commands/query 对账未知 commandId。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "核心断言是 renderer reload 后 unknown 静默清账；provider 只负责稳定创建前置 session。"
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_COMMAND_UNKNOWN_RECOVERY"],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "command-unknown-recovery-turn",
          "inputTokens": 80,
          "outputTokens": 8,
          "text": "COMMAND_UNKNOWN_RECOVERY_OK"
        }
      }
    }
  ]
}
