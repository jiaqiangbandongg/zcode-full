# syntax=docker/dockerfile:1.7

# Desktop Electron E2E demo image.
#
# Build and run with:
#   bash scripts/test-desktop-e2e-container.sh

FROM node:24.14.0-bookworm

ARG PNPM_VERSION=10.33.2

ENV CI=1 \
    HUSKY=0 \
    PNPM_HOME=/pnpm \
    PNPM_STORE_DIR=/pnpm/store \
    XDG_CACHE_HOME=/workspace/.cache \
    WDIO_BROWSER_DRIVER_CACHE_DIR=/workspace/.cache/wdio-browser-drivers \
    ZCODE_E2E_CONTAINER=1 \
    ZCODE_E2E_SPEC=./test/e2e/container-boot.test.ts,./test/e2e/smoke.test.ts,./test/e2e/e2ecase-regression.test.ts,./test/e2e/upstream-provider.test.ts \
    ELECTRON_DISABLE_SECURITY_WARNINGS=1 \
    TURBO_TELEMETRY_DISABLED=1

ENV PATH="${PNPM_HOME}:${PATH}"

# 使用 HTTPS 避免本机或 CI 的 HTTP 代理误拦带 URL 编码的 Debian 包路径。
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      dbus \
      dbus-x11 \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      g++ \
      git \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libsecret-1-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb-dri3-0 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxkbfile1 \
      libxrandr2 \
      libxrender1 \
      libxshmfence1 \
      libxss1 \
      libxtst6 \
      make \
      openssh-client \
      pkg-config \
      procps \
      python3 \
      unzip \
      wget \
      xdg-utils \
      xvfb \
      xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=zcode-desktop-e2e-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir "${PNPM_STORE_DIR}" && \
    pnpm install --frozen-lockfile

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends xauth && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${WDIO_BROWSER_DRIVER_CACHE_DIR}"

CMD ["bash", "-lc", "dbus-run-session -- pnpm --filter @zcode/desktop test:e2e ${EXTRA_WDIO_ARGS:-}"]
